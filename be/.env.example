# Turso Database Configuration
# If TURSO_DATABASE_URL is left empty, the server defaults to a local LibSQL SQLite file: math_exam.db
# To connect to Turso Cloud, run in Turso CLI:
# 1. turso db create math-exam
# 2. turso db show math-exam --url
# 3. turso db tokens create math-exam
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
PORT=3001
